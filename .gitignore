# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
# TASK-CLEANUP-002: local test output / capture files. These are re-created by
# every pytest run and must never be committed. The *.txt capture files are
# listed explicitly (instead of a blanket *.txt rule) because real documents,
# fixtures and prompts live in .txt files that DO belong in the repo.
*.out
pytest_*.txt
test_fail.txt
failure_details.txt
# Local runtime logs
*.log
# repomix one-shot repository snapshots (regenerate on demand, huge diffs)
repomix-output.xml
# Local config (may contain secrets) — never commit real values
config.yaml
config/providers.yaml
config/resources/

# Secrets — never commit
*.pem
*.key
.env
.env.*
*.secret

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Reference source only — not part of the gateway code
vertex-singbox/

# WEBUI-002: the Vue 3 + Vite Admin frontend. Dependencies and build output
# are reproducible from webui/package.json + package-lock.json, so only the
# source tree and the lockfile are tracked.
webui/node_modules/
webui/dist/
webui/*.local
webui/npm-debug.log*
