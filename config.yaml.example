# Gemini Gateway 配置示例（复制为 config.yaml 使用）
# 敏感信息一律通过环境变量占位符注入，禁止写入 Git。
# 占位符写法：NAME 来自环境变量 FIREBASE_PROJECT_01。
#
# 当前已集成 anonymous_vertex / firebase / gemini_cli / antigravity 等 Provider。
# 真实敏感信息（api_key 等）一律通过环境变量占位符注入，禁止写死。

server:
  host: 127.0.0.1
  port: 8000

scheduler:
  max_retries: 2
  cooldown:
    base_delay: 0.2      # 指数退避基数（秒）
    factor: 2.0          # 退避倍数
    max_delay: 10.0      # 退避上限（秒）
    jitter: 0.1          # 抖动比例
    degrade_threshold: 3

model_registry:
  refresh_interval: 300   # 模型索引 TTL（秒）；过期的索引会被并发安全地刷新

# ---- AUTH-009: Credential 持久化后端（可选）----
# 缺省为 memory（进程内 CredentialStore，AUTH-002/008）。显式选择 postgres
# 启用加密落库（AUTH-007 envelope + AAD 绑定 id/type）：
#   - 连接串来自环境变量 GEMINI_GATEWAY_DATABASE_URL（标准 PostgreSQL DSN，
#     Supabase 直连或 session pooler 均可，属部署配置）
#   - 加密主密钥来自 GEMINI_GATEWAY_DATABASE_URL 之外的独立环境变量
#     GEMINI_GATEWAY_ENCRYPTION_KEY（AUTH-007）
#   - 数据库不可达 / 配置缺失 → 启动失败（绝不静默回退到空内存库）
# credential_repository:
#   backend: postgres

# ---- AUTH-002: 可选的 Credential 定义 ----
# Credential 是长期认证材料的第一等所有者，Resource 通过 credential_id 引用它。
# type 表示材料的生命周期/处理类别（none | api_key | oauth），不是 Provider 名。
# 存储位置由 credential_repository.backend 决定：memory（缺省，进程内）或
# postgres（AUTH-009，payload 经 AUTH-007 AES-256-GCM 加密落库）。
# 另：AUTH-010 会在 postgres 模式下自动把 Resource 的 legacy 凭据字段
# （refresh_token/client_secret 等）迁移为加密 Credential 并回填
# credential_id——legacy 字段保留为兼容路径，无需手工迁移。
# 推荐写法：把长期认证材料集中放在 credentials 里，Resource 只写
# credential_id + 非敏感字段（如 project_id）。取消注释即可启用；下方
# firebase / gemini_cli 的 resources 已预留对应的 credential_id 注释行。
#
# credentials:
#   # Firebase：api_key / app_id / debug_token
#   - id: firebase-01
#     type: api_key
#     payload:
#       api_key: ${FIREBASE_01_API_KEY}
#       app_id: ${FIREBASE_01_APP_ID}
#       debug_token: ${FIREBASE_01_DEBUG_TOKEN}
#
#   # Gemini CLI：OAuth（refresh_token / client_id / client_secret）
#   - id: google-oauth-01
#     type: oauth
#     payload:
#       refresh_token: ${GEMINI_CLI_01_REFRESH_TOKEN}
#       client_id: ${GEMINI_CLI_01_CLIENT_ID}
#       client_secret: ${GEMINI_CLI_01_CLIENT_SECRET}

providers:
  fake:
    enabled: true
    resources:
      - id: fake-01
        provider: fake
        scenario: success          # success | rate_limit | auth_error | authz_error | timeout | server_error | content_filter | unknown_model
      - id: fake-02
        provider: fake
        scenario: rate_limit
        retry_after: 1.0           # 模拟上游 Retry-After（秒）

# anonymous_vertex（Anonymous Vertex / Agent Platform studio）
# 这是第一个真实上游（非官方接口，反向工程性质）。api_key 可省略（走匿名 key）；如需自定义，
# 通过环境变量占位符注入，禁止把真实 key 写进配置。
# 注意：每次请求都需要获取 reCAPTCHA Enterprise token。默认运行路径为
# fetch_recaptcha_token()，会真实访问 https://www.google.com/recaptcha/enterprise/
# 的 anchor（GET）+ reload（POST）流程；因此该 provider 在运行时依赖 Google 的
# reCAPTCHA 端点可用性。FakeRecaptchaTokenProvider 仅为测试替身，仅在注入
# token_fetcher / 调用 set_token_fetcher() 时使用，不是运行时默认实现。
  anonymous_vertex:
    enabled: true
    # 模型列表（可选）：覆盖内置文本模型清单。缺省使用 provider 内置清单
    #（gemini-2.5-flash ... gemini-3.8-flash）。
    # models:
    #   - gemini-3.8-flash
    #   - gemini-3.7-flash
    #
    # 执行节点池（ANON-004，可选）。缺省 = 单个直连 default 节点。
    # 每个 Node 是一条完整、固定的出站执行路径（自己的 transport/proxy，
    # 自己的 reCAPTCHA + batchGraphql），一次 attempt 全程绑定一个 Node。
    # 429 / reCAPTCHA 失败只冷却该 Node，不影响 provider 级健康。
    # node_pool:
    #   max_attempts: 3                 # 每次请求的节点尝试上限
    #   rate_limit_cooldown:            # 429 递增冷却（秒）：30/60/120...
    #     base: 30.0
    #     factor: 2.0
    #     max: 600.0
    #   nodes:
    #     - id: node-a
    #       weight: 1                   # 同等负载时的优先级（大者优先）
    #       max_concurrency: 8          # 节点并发上限
    #       proxy: {scheme: socks5, host: PROXY_HOST, port: PROXY_PORT}
    #     - id: node-b
    #       max_concurrency: 4
    #       enabled: false              # 停用节点不参与调度
    resources:
      - id: default
        # provider: anonymous_vertex   # 缺省自动设为 provider_id
        # pinned_model: gemini-2.5-flash  # 可选：把该资源固定到某个模型
        # 代理可选：直接直连
        # proxy:
        #   scheme: socks5
        #   host: PROXY_HOST
        #   port: PROXY_PORT

# ---- TASK-004: Firebase AI Logic（firebasevertexai）----
# 一个 Firebase Project = 一个 Resource。
# 推荐：凭证放在上方 credentials 定义的 Credential 里，Resource 只写
# credential_id + project_id。project_id 属于非敏感字段。
  firebase:
    enabled: true
    # 模型列表（配置快照，非上游探测）：覆盖默认清单（gemini-3.8-flash /
    # gemini-3.7-flash）。模型是否真实可用以 Firebase 项目配额 + 上游 404 为准。
    # models:
    #   - gemini-3.8-flash
    #   - gemini-3.7-flash
    resources:
      - id: firebase-project-01
        # 推荐：引用上方 credentials 中的 firebase-01（api_key/app_id/debug_token）
        # credential_id: firebase-01
        project_id: FIREBASE_PROJECT_01
        # ---- legacy 兼容路径：以下为 Resource 上的 inline 凭据字段。
        # 仅在迁移期/无 Credential 后端时使用；新配置请改用上面的 credential_id。
        api_key: ${FIREBASE_01_API_KEY}
        app_id: ${FIREBASE_01_APP_ID}
        debug_token: ${FIREBASE_01_DEBUG_TOKEN}
        # proxy: socks5://user:pass@host:port   # 可选；缺省直连
      - id: firebase-project-02
        project_id: FIREBASE_PROJECT_02
        api_key: ${FIREBASE_02_API_KEY}
        app_id: ${FIREBASE_02_APP_ID}
        debug_token: ${FIREBASE_02_DEBUG_TOKEN}

# TASK-008: Gemini CLI (Google Code Assist) Provider
# 协议：cloudcode-pa.googleapis.com/v1internal（OAuth Bearer）。
# 每个资源 = 一个 Google OAuth 账号（凭证经浏览器一次性 onboarding 后落盘，
# 引导脚本见 docs/TASK-008-IMPLEMENTATION.md）。
# 推荐：OAuth 材料放在上方 credentials 定义的 Credential 里，Resource 只写
# credential_id + project_id。project_id 属于非敏感字段。
  gemini_cli:
    enabled: true
    # 模型列表（配置快照）：覆盖默认清单（gemini-2.5-flash / gemini-2.5-pro）
    # models:
    #   - gemini-2.5-flash
    # ---- 代理配置（provider 级，TASK-ARCH-004）。
    # 一个 Provider 只拥有一个 HttpExecutionBackend，而该 Backend
    # 只拥有一个共享的 AsyncClient，因此代理属于
    # Provider 层的 transport 配置，对该 Provider 下的所有
    # Resource 生效；缺省直连。
    # proxy: socks5://user:pass@host:port
    resources:
      - id: cli-account-01
        # 推荐：引用上方 credentials 定义的凭据（AUTH-002）
        # credential_id: google-oauth-01
        # ---- legacy 兼容路径：以下为 Resource 上的 inline 凭据字段。
        # 仅在迁移期/无 Credential 后端时使用；新配置请改用上面的 credential_id。
        # 首次 onboarding 后写入 resource 的字段（令牌/项目由脚本生成）：
        refresh_token: ${GEMINI_CLI_01_REFRESH_TOKEN}
        client_id: ${GEMINI_CLI_01_CLIENT_ID}
        client_secret: ${GEMINI_CLI_01_CLIENT_SECRET}
        project_id: ${GEMINI_CLI_01_PROJECT_ID}
        # ---- legacy 兼容：Resource 级 proxy。仅兼容旧配置，
        # 新配置请写上方 provider 级的 proxy。兼容规则：
        #   1) provider 级 proxy 已配置 → provider 级优先，
        #      Resource 级被忽略；
        #   2) provider 级未配置且只有一个 Resource 写了
        #      proxy → 采用它；
        #   3) 同一 Provider 下多个 Resource 写了不同的 proxy
        #      → 启动期直接报配置错误（不会静默走第一个）。
        # proxy: socks5://user:pass@host:port

# ---- DB-RESOURCE-006: resource bootstrap --------------------------------
# 将 config 中的 resource definitions 通过 bootstrap 流程应用到
# ResourceRepository sink（当前为进程内内存实现；PostgreSQL 部署后续任务）。
# 缺省（不配置本节）= 完全关闭，保持 DB-RESOURCE-006 之前的行为。
# resource_bootstrap:
#   enabled: true
#   mode: check        # check = 只生成 plan，不写 sink
#                      # import = sink 缺失的定义执行插入；冲突只报告不覆盖
#                      # overwrite 已不再支持作为启动模式（CONFIG-001-ADR）：
#                      #   破坏性同步请使用一次性 resource import 工具。
# 注意：启用后 config 中的 resource definitions 会经过严格 DTO 校验
#（fail-closed）。legacy 凭据字段（refresh_token 等）不是合法的
# definition 字段——启用 bootstrap 前请先完成 AUTH-010 凭据迁移或改为
# credential_id 引用。

# ---- DB-RESOURCE-011: resource store backend ----------------------------
# 选择 resource definitions 的持久 sink。缺省 memory（无需数据库，
# 保持 011 之前的行为）；postgres 走 GEMINI_GATEWAY_DATABASE_URL 环境变量
#（与 credential store 共用），缺失时启动失败（fail-closed，不回退内存）。
# resource_store:
#   backend: memory      # memory | postgres
