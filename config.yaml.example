# Gemini Gateway 配置示例（复制为 config.yaml 使用）
# 敏感信息一律通过环境变量占位符注入，禁止写入 Git。
# 占位符写法：NAME 来自环境变量 FIREBASE_PROJECT_01（TASK-002 起）。
#
# TASK-002 已接入第一个真实上游 anonymous_vertex（Anonymous Vertex /
# Agent Platform studio 逆向协议）；fake 仅用于离线测试。
# 真实敏感信息（api_key 等）一律通过环境变量占位符注入，禁止写死。

server:
  host: 127.0.0.1
  port: 8000

scheduler:
  max_retries: 2
  cooldown:
    base_delay: 0.2      # 指数退避基数（秒）
    factor: 2.0          # 退避倍数
    max_delay: 10.0      # 退避上限（秒）
    jitter: 0.1          # 抖动比例
    degrade_threshold: 3

model_registry:
  refresh_interval: 300   # 模型索引 TTL（秒）；过期的索引会被并发安全地刷新

providers:
  fake:
    enabled: true
    resources:
      - id: fake-01
        provider: fake
        scenario: success          # success | rate_limit | auth_error | authz_error | timeout | server_error | content_filter | unknown_model
      - id: fake-02
        provider: fake
        scenario: rate_limit
        retry_after: 1.0           # 模拟上游 Retry-After（秒）

# TASK-002: Anonymous Vertex（Anonymous Vertex / Agent Platform studio）
# 这是第一个真实 Google 上游。api_key 可省略（走匿名 key）；如需自定义，
# 通过环境变量占位符注入，禁止把真实 key 写进配置。
  anonymous_vertex:
    enabled: true
    # 模型列表（可选）：覆盖内置文本模型清单。缺省使用 provider 内置清单
    #（gemini-2.5-flash ... gemini-3.8-flash）。
    # models:
    #   - gemini-3.8-flash
    #   - gemini-3.7-flash
    resources:
      - id: default
        # provider: anonymous_vertex   # 缺省自动设为 provider_id
        # pinned_model: gemini-2.5-flash  # 可选：把该资源固定到某个模型
        # 代理可选：直接直连
        # proxy:
        #   scheme: socks5
        #   host: PROXY_HOST
        #   port: PROXY_PORT

# ---- TASK-004: Firebase AI Logic（firebasevertexai）----
# 一个 Firebase Project = 一个 Resource。凭证（api_key / app_id / debug_token）
# 一律通过环境变量占位符注入，禁止写死；真实凭证不得提交到 Git。
  firebase:
    enabled: true
    # 模型列表（配置快照，非上游探测）：覆盖默认清单（gemini-3.8-flash /
    # gemini-3.7-flash）。模型是否真实可用以 Firebase 项目配额 + 上游 404 为准。
    # models:
    #   - gemini-3.8-flash
    #   - gemini-3.7-flash
    resources:
      - id: firebase-project-01
        project_id: FIREBASE_PROJECT_01
        api_key: ${FIREBASE_01_API_KEY}
        app_id: ${FIREBASE_01_APP_ID}
        debug_token: ${FIREBASE_01_DEBUG_TOKEN}
        # proxy: socks5://user:pass@host:port   # 可选；缺省直连
      - id: firebase-project-02
        project_id: FIREBASE_PROJECT_02
        api_key: ${FIREBASE_02_API_KEY}
        app_id: ${FIREBASE_02_APP_ID}
        debug_token: ${FIREBASE_02_DEBUG_TOKEN}

# TASK-008: Gemini CLI (Google Code Assist) Provider
# 协议：cloudcode-pa.googleapis.com/v1internal（OAuth Bearer）。
# 每个资源 = 一个 Google OAuth 账号（凭证经浏览器一次性 onboarding 后落盘，
# 引导脚本见 docs/TASK-008-IMPLEMENTATION.md）。
# 敏感凭证一律通过环境变量占位符注入，禁止写死。
  gemini_cli:
    enabled: true
    # 模型列表（配置快照）：覆盖默认清单（gemini-2.5-flash / gemini-2.5-pro）
    # models:
    #   - gemini-2.5-flash
    resources:
      - id: cli-account-01
        # 首次 onboarding 后写入 resource 的字段（令牌/项目由脚本生成）：
        refresh_token: ${GEMINI_CLI_01_REFRESH_TOKEN}
        client_id: ${GEMINI_CLI_01_CLIENT_ID}
        client_secret: ${GEMINI_CLI_01_CLIENT_SECRET}
        project_id: ${GEMINI_CLI_01_PROJECT_ID}
        # proxy: socks5://user:pass@host:port   # 可选；缺省直连
