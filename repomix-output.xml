    resp = FakeResponse(200, sse_chunks=[body])
    events = await drain(iter_sse_events(resp))
    assert [e["candidates"][0]["content"]["parts"][0]["text"] for e in events] == [
        "hello ",
        "world",
    ]


async def test_sse_split_across_network_chunks():
