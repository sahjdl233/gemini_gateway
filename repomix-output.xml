    assert gc["temperature"] == 0.3
    assert gc["maxOutputTokens"] == 256  # max_tokens wins over max_completion_tokens
    assert gc["topP"] == 0.9
    assert gc["stopSequences"] == ["END", "STOP"]


def test_max_completion_tokens_fallback():
    req = make_request(
