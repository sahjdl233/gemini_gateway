                "project_id": "p-a",
                "api_key": "k-a",
                "app_id": "a-a",
                "debug_token": "d-a",
            },
            {
                "id": "project-b",
                "project_id": "p-b",
                "api_key": "k-b",
                "app_id": "a-b",
                "debug_token": "d-b",
